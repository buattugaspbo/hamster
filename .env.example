# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Integrasi Supabase Marketplace di Vercel dapat menyediakan alias berikut.
# Aplikasi menerima keduanya, jadi tidak perlu menggandakan nilainya.
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx
# SUPABASE_SECRET_KEY=sb_secret_xxx

# Opsional untuk mengganti QRIS merchant bawaan.
QRIS_STATIC_PAYLOAD=

# Opsional: endpoint webhook generik untuk acquirer/payment gateway.
PAYMENT_WEBHOOK_SECRET=ganti-dengan-rahasia-panjang

# Opsional tetapi disarankan pada Vercel. Jika diisi, Vercel Cron mengirim
# Authorization otomatis ke endpoint restock harian pukul 03.00 UTC (10.00 WIB).
CRON_SECRET=ganti-dengan-rahasia-panjang

# Opsional: vendor cadangan wilayah Indonesia. Sumber utama aplikasi sudah
# memakai dataset Kemendagri 2025 yang mencakup seluruh 38 provinsi hingga
# desa/kelurahan; jangan diisi kecuali Anda memang memakai vendor sendiri.
INDONESIA_REGION_API_URL=
INDONESIA_REGION_API_TOKEN=

# URL publik produksi, contoh: https://hop-and-ham.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
